{
  "name": "appearances",
  "version": "0.1.0",
  "description": "A flexible JS library for displaying items (lists, grids, cards, tables, etc.) with highly customizable appearances. Supports vanilla JS and React. Pure client-side — no API calls.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla/index.d.ts",
        "default": "./dist/vanilla/index.js"
      },
      "require": {
        "types": "./dist/vanilla/index.d.cts",
        "default": "./dist/vanilla/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "echo \"TODO: add tests\""
  },
  "keywords": [
    "grid",
    "list",
    "cards",
    "table",
    "views",
    "appearances",
    "react",
    "vanilla"
  ],
  "author": "Mayur Dubey",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "sideEffects": [
    "./src/vanilla/Appearance.js",
    "./dist/vanilla/*"
  ],
  "jsdelivr": "./dist/appearances.global.js",
  "unpkg": "./dist/appearances.global.js"
}
