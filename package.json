{
  "name": "appearances",
  "version": "0.1.0",
  "description": "A flexible JS library for displaying items (lists, grids, cards, tables, etc.) with highly customizable appearances. Supports vanilla JS and React. Pure client-side — no API calls.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "echo \"TODO: set up build (rollup/tsup)\"",
    "dev": "echo \"TODO: set up dev server\"",
    "test": "echo \"TODO: add tests\""
  },
  "keywords": [
    "grid",
    "list",
    "cards",
    "table",
    "views",
    "appearances",
    "react",
    "vanilla"
  ],
  "author": "Mayur Dubey",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "sideEffects": [
    "./src/vanilla/Appearance.js",
    "./dist/vanilla/*"
  ]
}
